{
  "name": "behdaad-github-io",
  "private": true,
  "scripts": {
    "build": "npm run build:blog && npm run build:portfolio",
    "build:blog": "eleventy --config=eleventy.config.js",
    "build:portfolio": "eleventy --config=portfolio.eleventy.config.js",
    "serve:blog": "eleventy --serve --config=eleventy.config.js",
    "serve:portfolio": "eleventy --serve --config=portfolio.eleventy.config.js",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@playwright/test": "^1.63.0"
  }
}
