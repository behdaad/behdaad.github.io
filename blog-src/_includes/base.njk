<!doctype html>
<html id="top" lang="{{ lang | default('en') }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width">
  <meta name="theme-color" content="#fbfcfe" id="theme-color">
  <title>{{ title }} | Behdad Keynejad</title>
  <link rel="preconnect" href="https://fonts.gstatic.com">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ relativeRoot }}/css/style.css">
  <link rel="stylesheet" href="{{ relativeRoot }}/css/blog.css">
  <link rel="icon" type="image/png" href="{{ relativeRoot }}/assets/favicon.png">
</head>
<body class="blog-page">
  <nav id="nav">
    <div class="nav-content">
      <div class="avatar">
        <a href="{{ relativeRoot }}/"><img src="{{ relativeRoot }}/assets/memoji.png" alt="Behdad Keynejad"></a>
      </div>
      <ul class="menu">
        <li><a href="{{ relativeRoot }}/">Home</a></li>
        <li><a href="{{ relativeRoot }}/about/">About</a></li>
        <li class="active"><a href="{{ blogRoot }}/">Blog</a></li>
        <li><a href="{{ relativeRoot }}/resume/Behdad-Keynejad-Resume.pdf" target="_blank">Resume</a></li>
      </ul>
    </div>
  </nav>

  <main class="main blog-main{% if pageClass %} {{ pageClass }}{% endif %}"{% if direction %} dir="{{ direction }}"{% endif %}>
{% if pageClass === "post" %}
      <header class="post-header">
        <div class="post-meta">
          <p class="post-date">{{ date | dateDisplay }}</p>
          {% if tags %}<ul class="post-tags" aria-label="{{ tagsLabel | default('Tags') }}">{% for tag in tags %}<li><a href="{{ tagLinkPrefix | default('') }}tags/{{ tag | tagSlug }}/">{{ tag }}</a></li>{% endfor %}</ul>{% endif %}
        </div>
        <h1>{{ title }}</h1>
{% if description %}        <p class="post-description">{{ description }}</p>
{% endif %}
      </header>
{% endif %}
    {{ content | safe }}
  </main>

  <footer>
    <div class="footer-content">
      <div>© <span id="year"></span> Behdad Keynejad</div>
      <div class="theme-picker">
        <button class="theme-picker-trigger" type="button" aria-expanded="false" aria-haspopup="menu" aria-controls="theme-picker-menu">
          <span class="theme-picker-icon" aria-hidden="true">
            <svg class="theme-icon theme-icon-auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18"/><path d="M8.5 5.1A7 7 0 1 0 8.5 18.9a7 7 0 0 1 0-13.8Z"/><path d="M12 5a7 7 0 0 1 0 14"/></svg>
          </span>
          <span class="sr-only">Choose color theme</span>
        </button>
        <div class="theme-picker-menu" id="theme-picker-menu" role="menu" aria-label="Color theme" hidden>
          <button type="button" role="menuitemradio" aria-checked="false" data-theme-choice="light">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
            <span>Light</span>
          </button>
          <button type="button" role="menuitemradio" aria-checked="true" data-theme-choice="auto">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v18"/><path d="M8.5 5.1A7 7 0 1 0 8.5 18.9a7 7 0 0 1 0-13.8Z"/><path d="M12 5a7 7 0 0 1 0 14"/></svg>
            <span>Auto</span>
          </button>
          <button type="button" role="menuitemradio" aria-checked="false" data-theme-choice="dark">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5 6.5 6.5 0 0 0 20.5 14.2Z"/></svg>
            <span>Dark</span>
          </button>
        </div>
      </div>
      <div class="padding"></div>
      <div class="social">
        <a href="mailto:hi@behdaad.me"><img src="{{ relativeRoot }}/assets/icons/mail.svg" alt="Email"></a>
        <a href="https://www.linkedin.com/in/behdaad"><img src="{{ relativeRoot }}/assets/icons/linkedin.svg" alt="LinkedIn"></a>
        <a href="https://github.com/behdaad"><img src="{{ relativeRoot }}/assets/icons/github.svg" alt="GitHub"></a>
      </div>
    </div>
  </footer>
  <script src="{{ relativeRoot }}/js/script.js"></script>
</body>
</html>
