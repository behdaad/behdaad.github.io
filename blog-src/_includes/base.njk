<!doctype html>
<html id="top" lang="{{ archive.lang | default(lang) | default('en') }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width">
  <meta name="description" content="{{ description | default(archive.name) | default(title) }}">
  <meta name="theme-color" content="#fbfcfe" id="theme-color">
  <script>
    (function () {
      var systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      var fallback = systemDark ? "dark" : "light";
      var preference = fallback;

      try {
        var stored = localStorage.getItem("blog-theme");
        if (stored === "light" || stored === "dark" || stored === "auto") {
          preference = stored;
        }
      } catch (error) {
        preference = fallback;
      }

      var theme = preference === "auto" ? fallback : preference;
      document.documentElement.dataset.theme = theme;
      document.documentElement.dataset.themePreference = preference;
      document.querySelector("meta[name='theme-color']").setAttribute("content", theme === "dark" ? "#171a1e" : "#fbfcfe");
    }());
  </script>
  <title>{{ archive.name | default(title) }} | Behdad Keynejad</title>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;700;800&family=Vazirmatn:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ relativeRoot }}/css/style.css">
  <link rel="stylesheet" href="{{ relativeRoot }}/css/blog.css?v=4">
  <link rel="icon" type="image/png" href="{{ relativeRoot }}/assets/favicon.png">
</head>
<body class="blog-page">
  <a class="skip-link" href="#main-content">Skip to content</a>
  <nav id="nav" aria-label="Primary">
    <div class="nav-content">
      <div class="avatar">
        <a href="{{ relativeRoot }}/"><img src="{{ relativeRoot }}/assets/memoji.png" alt="Behdad Keynejad"></a>
      </div>
      <ul class="menu">
        <li><a href="{{ relativeRoot }}/">Home</a></li>
        <li><a href="{{ relativeRoot }}/about/">About</a></li>
        <li class="active"><a href="{{ blogRoot }}/" aria-current="page">Blog</a></li>
        <li><a href="{{ relativeRoot }}/resume/Behdad-Keynejad-Resume.pdf" target="_blank" rel="noopener">Resume</a></li>
      </ul>
      <div class="theme-picker">
        <button class="theme-picker-trigger" type="button" aria-expanded="false" aria-haspopup="menu" aria-controls="theme-picker-menu">
          <span class="theme-picker-icon" aria-hidden="true">
            <svg class="theme-icon theme-icon-auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="2" fill="currentColor" fill-opacity="0.22"/><path d="M8 20h8M12 16v4"/></svg>
          </span>
          <span class="sr-only">Choose color theme</span>
        </button>
        <div class="theme-picker-menu" id="theme-picker-menu" role="menu" aria-label="Color theme" hidden>
          <button type="button" role="menuitemradio" aria-checked="false" data-theme-choice="light">
            <svg class="theme-icon theme-icon-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="currentColor" fill-opacity="0.34"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
            <span>Light</span>
          </button>
          <button type="button" role="menuitemradio" aria-checked="true" data-theme-choice="auto">
            <svg class="theme-icon theme-icon-auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2" fill="currentColor" fill-opacity="0.22"/><path d="M8 20h8M12 16v4"/></svg>
            <span>Auto</span>
          </button>
          <button type="button" role="menuitemradio" aria-checked="false" data-theme-choice="dark">
            <svg class="theme-icon theme-icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5 6.5 6.5 0 0 0 20.5 14.2Z" fill="currentColor" fill-opacity="0.58"/></svg>
            <span>Dark</span>
          </button>
        </div>
      </div>
    </div>
  </nav>

{% set contentDirection = archive.direction | default(direction) %}
  <main id="main-content" class="main blog-main{% if pageClass %} {{ pageClass }}{% endif %}"{% if contentDirection %} dir="{{ contentDirection }}"{% endif %} tabindex="-1">
{% if pageClass === "post" %}
      <header class="post-header">
        <div class="post-meta">
          <p class="post-date">{{ date | dateDisplay }}</p>
          {% if tags %}<ul class="post-tags" aria-label="{{ tagsLabel | default('Tags') }}">{% for tag in tags %}<li><a href="{{ tagLinkPrefix | default('') }}tags/{{ tag | tagSlug }}/">{{ tag }}</a></li>{% endfor %}</ul>{% endif %}
        </div>
        <h1>{{ title }}</h1>
{% if description %}        <p class="post-description">{{ description }}</p>
{% endif %}
      </header>
{% endif %}
{% if pageClass === "post" %}    <div class="post-content">
      {{ content | safe }}
    </div>
{% else %}    {{ content | safe }}
{% endif %}
  </main>

  <footer>
    <div class="footer-content">
      <div>© <span id="year"></span> Behdad Keynejad</div>
      <div class="padding"></div>
      <div class="social">
        <a href="mailto:hi@behdaad.me"><img src="{{ relativeRoot }}/assets/icons/mail.svg" alt="Email"></a>
        <a href="https://www.linkedin.com/in/behdaad"><img src="{{ relativeRoot }}/assets/icons/linkedin.svg" alt="LinkedIn"></a>
        <a href="https://github.com/behdaad"><img src="{{ relativeRoot }}/assets/icons/github.svg" alt="GitHub"></a>
      </div>
    </div>
  </footer>
  <script src="{{ relativeRoot }}/js/script.js?v=3"></script>
</body>
</html>
