---
layout: base.njk
title: Blog
relativeRoot: ..
blogRoot: .
---
<header class="blog-header">
  <p class="blog-eyebrow">Writing</p>
  <h1>Blog</h1>
  <p>Notes on building products, technology, and whatever else holds my attention.</p>
</header>

<section class="post-list" aria-label="Blog posts">
{% for post in collections.post %}
    <article class="post-card"{% if post.data.lang %} lang="{{ post.data.lang }}"{% endif %}{% if post.data.direction %} dir="{{ post.data.direction }}"{% endif %}>
      <div class="post-meta">
        <p class="post-date">{{ post.date | dateDisplay }}</p>
        {% if post.data.tags %}<ul class="post-tags" aria-label="{{ post.data.tagsLabel | default('Tags') }}">{% for tag in post.data.tags %}<li>{{ tag }}</li>{% endfor %}</ul>{% endif %}
      </div>
      <h2><a href="{{ post.fileSlug }}/">{{ post.data.title }}</a></h2>
      {% if post.data.description %}<p>{{ post.data.description }}</p>{% endif %}
      <a class="post-link" href="{{ post.fileSlug }}/">{{ post.data.readMore | default('Read post') }} <span aria-hidden="true">{{ post.data.readMoreArrow | default('→') }}</span></a>
    </article>
{% endfor %}
</section>
