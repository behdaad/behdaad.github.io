<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }} · Behdad Keynejad</title>
    <link rel="icon" href="/assets/favicon.png">
    <link rel="stylesheet" href="/ratings/style.css?v=7">
    <script src="/ratings/app.js?v=9" defer></script>
</head>
<body>
    <header class="masthead wrap">
        <a class="wordmark" href="/ratings/"{% if not dataset %} aria-current="page"{% endif %}>Ratings</a>
        <nav aria-label="Main">
            {%- for category in collections.ratings %}
            <a href="{{ category.url }}"{% if page.url == category.url %} aria-current="page"{% endif %}>{{ category.data.categoryName }}</a>
            {%- endfor %}
            <a href="/">Behdad <span aria-hidden="true">↗</span></a>
        </nav>
        <div class="theme-control">
            <label for="theme">Theme</label>
            <select id="theme" disabled>
                <option value="slate">Slate (light)</option>
                <option value="midnight">Midnight (dark)</option>
            </select>
        </div>
    </header>
    <main class="wrap">
        <header class="hero">
            <h1>{% if heading %}{{ heading }} {% endif %}<em>Ratings</em></h1>
            {%- if description %}
            <p>{{ description }}</p>
            {%- endif %}
        </header>
        {%- if dataset %}
        <section data-ratings="{{ dataset }}" data-singular="{{ singular }}" data-plural="{{ plural }}">
            <div class="controls" id="{{ plural }}">
                <label for="search">{{ searchLabel }}
                    <input id="search" type="search" placeholder="Search" disabled>
                </label>
            </div>
            <p id="status" role="status">Loading {{ plural }}…</p>
            <noscript>Enable JavaScript to view the ratings.</noscript>
            <div class="table-scroll" role="region" aria-label="{{ title }} table" tabindex="0" hidden>
                <table>
                    <thead>
                        <tr>
                            {%- if showRowNumbers %}
                            <th scope="col" class="row-number" aria-label="Row number">#</th>
                            {%- endif %}
                            {%- for column in columns %}
                            <th scope="col"{% if column.compact %} class="compact"{% endif %}{% if column.initial %} aria-sort="{{ column.direction or 'ascending' }}"{% endif %}><button type="button" data-sort="{{ column.key }}"{% if column.direction %} data-direction="{{ column.direction }}"{% endif %}{% if column.search %} data-searchable{% endif %}>{{ column.label }} <span aria-hidden="true"></span></button></th>
                            {%- endfor %}
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </section>
        {%- else %}
{{ content | trim | indent(8, true) | safe }}
        {%- endif %}
    </main>
</body>
</html>
